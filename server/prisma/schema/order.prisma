model Order {
    id         String   @id @default(uuid())
    createdAt  DateTime @default(now())
    updateAt   DateTime @updatedAt
    customerId String
    customer   Customer @relation(fields: [customerId], references: [id])
    providerId String
    provider   Provider @relation(fields: [providerId], references: [id])

    totalAmount   Int
    orderStatus   OrderStatus   @default(PENDING)
    paymentStatus PaymentStatus @default(UNPAID)

    deliveryAddress String
    orderItems      OrderItem[]

    // New fields for better tracking
    estimatedDelivery DateTime?

    paymentMethod PaymentMethod
    payments      Payment[]

    @@map("orders")
}

model OrderItem {
    id      String @id @default(uuid())
    orderId String
    order   Order  @relation(fields: [orderId], references: [id])
    mealId  String
    meal    Meal   @relation(fields: [mealId], references: [id])

    quantity        Int
    priceAtPurchase Int // snapshot of the price user actually pays if whey buy on sale or lower price

    @@map("order_items")
}

enum OrderStatus {
    PENDING // Order placed, but not yet confirmed/processed
    CONFIRMED // Order verified (often via OTP or call for COD)
    SHIPPED // Handed over to the courier
    OUT_FOR_DELIVERY // Courier is attempting delivery today
    DELIVERED // Package handed over and cash collected
    CANCELLED // Cancelled by user or admin before shipping
    REJECTED // Customer refused the package at the doorstep
    FAILED_ATTEMPT // Courier tried to deliver but customer was unavailable
    RETURNED // Item sent back to warehouse after failed delivery
}

enum PaymentMethod {
    COD
    STRIPE
}
